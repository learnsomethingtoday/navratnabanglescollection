---
import { siteUrl } from '@/lib/site-url';
import { siteConfig, whatsappUrl } from '@/data/site-config';
import Icon from '@/components/shared/Icon.astro';
---
<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand-area">
      <div class="footer-brand">
        <div class="footer-brand-lockup">
          <span class="footer-brand-gem" aria-hidden="true"><Icon name="sparkle" size={24} /></span>
          <p class="footer-wordmark">Navira</p>
        </div>
        <p>Jewels chosen for grace, thoughtfully presented for every kind of celebration.</p>
        <p class="footer-bulk-note">Bulk orders are welcome — call or WhatsApp us to discuss your requirements.</p>
      </div>
      <nav class="footer-links" aria-label="Footer navigation">
        <h2>Explore</h2>
        <div class="footer-link-row"><a href={siteUrl('/collection/')}>Collection</a><a href={siteUrl('/about/')}>Our Story</a><a href={siteUrl('/contact/')}>Contact</a></div>
      </nav>
    </div>
    <div class="footer-contact">
      <h2>Get in touch</h2>
      <div class="footer-contact-links">
        <a class="footer-contact-link" href={`tel:${siteConfig.phoneHref}`}><span>Call us</span><strong>{siteConfig.phoneDisplay}</strong></a>
        <a class="footer-contact-link" href={whatsappUrl('Hello Navira Jewels, I would like to know more about your collection.')} target="_blank" rel="noopener"><span>WhatsApp</span><strong>Send an enquiry</strong></a>
      </div>
      <div class="footer-service-list" aria-label="Service information">
        <div><strong>Local delivery</strong><span>{siteConfig.localDelivery}</span></div>
        <div><strong>Regional dispatch</strong><span>{siteConfig.regionalDispatch}</span></div>
        <div><strong>Response time</strong><span>{siteConfig.responseTime}</span></div>
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} {siteConfig.name}</span>
    <span>Collection only · No online ordering</span>
  </div>
</footer>
<style>
  .footer { padding: 72px 0 24px; background: var(--maroon-dark); color: #f8eee8; }
  .footer-grid { display: grid; align-items: stretch; gap: clamp(52px, 8vw, 110px); grid-template-columns: minmax(0, .9fr) minmax(360px, 1.1fr); }
  .footer-brand-area { position: relative; display: grid; min-height: 100%; align-content: space-between; gap: 44px; padding: 8px clamp(18px, 3vw, 44px) 8px 0; }
  .footer-brand, .footer-links { position: relative; z-index: 1; }
  .footer-links, .footer-contact { display: flex; flex-direction: column; align-items: stretch; }
  .footer-links { padding-top: 28px; border-top: 1px solid rgb(230 210 170 / 24%); }
  .footer h2 { margin: 0 0 18px; color: var(--gold-soft); font-family: var(--sans); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; }
  .footer a { color: inherit; font-size: .9rem; text-decoration: none; }
  .footer a:hover { color: var(--gold-soft); }
  .footer span { color: #d1c1ba; font-size: .82rem; }
  .footer-brand-lockup { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
  .footer-brand-gem { display: grid; width: 46px; height: 46px; flex: 0 0 46px; place-items: center; border: 1px solid var(--gold-soft); border-radius: 50%; color: var(--gold-soft); }
  .footer-wordmark { margin: 0; color: white; font-family: var(--serif); font-size: 3.4rem; line-height: 1; }
  .footer-brand > p:nth-child(2) { max-width: 37ch; color: #d1c1ba; font-size: .9rem; }
  .footer-bulk-note { max-width: 42ch; margin: 14px 0 0; color: var(--gold-soft); font-size: .78rem; font-weight: 600; line-height: 1.55; }
  .footer-link-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .footer-link-row a { min-width: 104px; padding: 9px 14px; border: 1px solid rgb(255 255 255 / 14%); border-radius: 999px; text-align: center; transition: border-color .2s ease, background .2s ease; }
  .footer-link-row a:hover { border-color: rgb(230 210 170 / 55%); background: rgb(255 255 255 / 6%); }
  .footer-contact-links { display: grid; gap: 10px; }
  .footer-contact-link { display: grid; gap: 2px; padding: 12px 14px; border: 1px solid rgb(255 255 255 / 14%); border-radius: var(--radius-sm); background: rgb(255 255 255 / 4%); transition: border-color .2s ease, background .2s ease; }
  .footer-contact-link:hover { border-color: rgb(230 210 170 / 55%); background: rgb(255 255 255 / 7%); }
  .footer-contact-link strong { color: white; font-size: .9rem; font-weight: 600; }
  .footer-contact-link span { color: var(--gold-soft); font-size: .68rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .footer-service-list { display: grid; gap: 12px; margin-top: 20px; padding-top: 20px; border-top: 1px solid rgb(255 255 255 / 12%); }
  .footer-service-list > div { display: grid; gap: 2px; grid-template-columns: minmax(110px, .55fr) minmax(0, 1.45fr); }
  .footer-service-list strong { color: #f8eee8; font-size: .72rem; font-weight: 600; }
  .footer-service-list span { line-height: 1.55; }
  .footer-bottom { display: flex; justify-content: space-between; margin-top: 64px; padding-top: 20px; border-top: 1px solid rgb(255 255 255 / 12%); }
  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr; } .footer-brand-area { min-height: auto; padding-right: 0; } .footer-contact { padding-top: 42px; border-top: 1px solid rgb(255 255 255 / 12%); } }
  @media (max-width: 520px) { .footer-brand-area { gap: 42px; } .footer-brand-gem { width: 42px; height: 42px; flex-basis: 42px; } .footer-link-row { align-items: stretch; flex-direction: column; } .footer-link-row a { width: 100%; text-align: left; } .footer-service-list > div { gap: 3px; grid-template-columns: 1fr; } .footer-bottom { align-items: flex-start; flex-direction: column; gap: 8px; } }
</style>
