---
import { siteConfig, whatsappUrl } from '@/data/site-config';
---
<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <p class="footer-wordmark">Navira</p>
      <p>Jewels chosen for grace, thoughtfully presented for every kind of celebration.</p>
      <span class="placeholder-label">Working brand</span>
    </div>
    <div>
      <h2>Explore</h2>
      <a href="/catalogue/">Catalogue</a><a href="/about/">Our Story</a><a href="/contact/">Contact</a>
    </div>
    <div>
      <h2>Get in touch</h2>
      <a href={`tel:${siteConfig.phoneHref}`}>{siteConfig.phoneDisplay}</a>
      <a href={whatsappUrl('Hello Navira Jewels, I would like to know more about your catalogue.')} target="_blank" rel="noopener">WhatsApp enquiry</a>
      <span>{siteConfig.serviceArea}</span>
      <span>{siteConfig.responseTime}</span>
    </div>
    <div>
      <h2>Follow</h2>
      {siteConfig.socialLinks.map((link) => <span>{link.label} <small>Dummy link</small></span>)}
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} {siteConfig.name}</span>
    <span>Catalogue only · No online ordering</span>
  </div>
</footer>
<style>
  .footer { padding: 72px 0 24px; background: var(--maroon-dark); color: #f8eee8; }
  .footer-grid { display: grid; gap: 48px; grid-template-columns: 1.5fr repeat(3, 1fr); }
  .footer-grid > div:not(:first-child) { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .footer h2 { margin-bottom: 10px; color: var(--gold-soft); font-family: var(--sans); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; }
  .footer a { color: inherit; font-size: .9rem; text-decoration: none; }
  .footer a:hover { color: var(--gold-soft); }
  .footer span { color: #d1c1ba; font-size: .82rem; }
  .footer small { margin-left: 4px; color: #b5a39c; font-size: .62rem; text-transform: uppercase; }
  .footer-wordmark { margin: 0 0 14px; color: white; font-family: var(--serif); font-size: 3.4rem; line-height: 1; }
  .footer-brand > p:nth-child(2) { max-width: 37ch; color: #d1c1ba; font-size: .9rem; }
  .footer-brand .placeholder-label { border-color: rgb(230 210 170 / 35%); background: rgb(255 255 255 / 5%); color: var(--gold-soft); }
  .footer-bottom { display: flex; justify-content: space-between; margin-top: 64px; padding-top: 20px; border-top: 1px solid rgb(255 255 255 / 12%); }
  @media (max-width: 800px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .footer-grid { grid-template-columns: 1fr; } .footer-bottom { align-items: flex-start; flex-direction: column; gap: 8px; } }
</style>
