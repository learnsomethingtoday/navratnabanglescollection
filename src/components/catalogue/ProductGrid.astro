---
import ProductCard from './ProductCard.astro';
import type { ProductEntry } from '@/lib/products';
const { products, id } = Astro.props as { products: ProductEntry[]; id?: string };
---
<div class="product-grid" id={id}>
  {products.map((product) => <ProductCard product={product} />)}
</div>
<style>
  .product-grid { display: grid; gap: clamp(18px, 2.5vw, 30px); grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (min-width: 1120px) { .product-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 840px) { .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 540px) { .product-grid { grid-template-columns: 1fr; } }
</style>
