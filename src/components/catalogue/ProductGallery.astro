---
import Icon from '@/components/shared/Icon.astro';
interface GalleryImage { src: string; alt: string; focalPosition?: string; }
const { images, productName } = Astro.props as { images: GalleryImage[]; productName: string };
---
<div class="gallery" data-gallery>
  <div class="gallery-main">
    {images.map((image, index) => (
      <img src={image.src} alt={image.alt} width="900" height="900" data-gallery-image={index} hidden={index !== 0} style={`object-position:${image.focalPosition ?? 'center'}`} />
    ))}
    <span class="placeholder-label">Preview photography</span>
    <button class="zoom-button" type="button" aria-label={`Enlarge image of ${productName}`} data-open-zoom>View larger</button>
  </div>
  {images.length > 1 && <div class="thumbnails" aria-label="Choose product image">
    {images.map((image, index) => <button type="button" aria-label={`Show image ${index + 1} of ${images.length}`} aria-pressed={index === 0 ? 'true' : 'false'} data-thumb={index}><img src={image.src} alt="" width="90" height="90" /></button>)}
  </div>}
  <dialog class="image-dialog" data-image-dialog aria-label={`Enlarged image of ${productName}`}>
    <button class="dialog-close" type="button" aria-label="Close enlarged image" data-close-zoom><Icon name="close" /></button>
    <img src={images[0].src} alt={images[0].alt} width="1200" height="1200" data-dialog-image />
  </dialog>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const images = [...gallery.querySelectorAll<HTMLImageElement>('[data-gallery-image]')];
    const dialog = gallery.querySelector<HTMLDialogElement>('[data-image-dialog]');
    const dialogImage = gallery.querySelector<HTMLImageElement>('[data-dialog-image]');
    const selectImage = (index: number) => {
      images.forEach((image, imageIndex) => { image.hidden = imageIndex !== index; });
      gallery.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((button, buttonIndex) => button.setAttribute('aria-pressed', String(buttonIndex === index)));
      const selected = images[index];
      if (dialogImage && selected) { dialogImage.src = selected.src; dialogImage.alt = selected.alt; }
    };
    gallery.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((button) => button.addEventListener('click', () => selectImage(Number(button.dataset.thumb))));
    gallery.querySelector<HTMLButtonElement>('[data-open-zoom]')?.addEventListener('click', () => dialog?.showModal());
    gallery.querySelector<HTMLButtonElement>('[data-close-zoom]')?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  });
</script>
<style>
  .gallery { min-width: 0; }
  .gallery-main { position: relative; display: grid; aspect-ratio: 1 / 1; place-items: center; overflow: hidden; border: 1px solid var(--line); border-radius: var(--radius-lg); background: #f1e9dd; }
  .gallery-main > img { width: 100%; height: 100%; object-fit: contain; }
  .gallery-main .placeholder-label { position: absolute; top: 18px; left: 18px; }
  .zoom-button { position: absolute; right: 18px; bottom: 18px; min-height: 44px; padding: 9px 16px; border: 1px solid var(--line); border-radius: 999px; background: rgb(255 253 249 / 92%); color: var(--maroon); font-size: .75rem; font-weight: 600; cursor: pointer; }
  .thumbnails { display: flex; gap: 10px; margin-top: 14px; overflow-x: auto; }
  .thumbnails button { width: 82px; height: 82px; padding: 3px; border: 1px solid var(--line); border-radius: 10px; background: var(--paper); cursor: pointer; }
  .thumbnails button[aria-pressed='true'] { border: 2px solid var(--maroon); }
  .thumbnails img { width: 100%; height: 100%; object-fit: contain; }
  .image-dialog { width: min(92vw, 840px); max-height: 90vh; padding: 36px; border: 0; border-radius: var(--radius-md); background: var(--paper); box-shadow: var(--shadow-md); }
  .image-dialog::backdrop { background: rgb(24 14 13 / 72%); backdrop-filter: blur(5px); }
  .image-dialog img { width: 100%; max-height: calc(90vh - 72px); object-fit: contain; }
  .dialog-close { position: absolute; top: 10px; right: 10px; display: grid; width: 44px; height: 44px; place-items: center; border: 1px solid var(--line); border-radius: 50%; background: var(--white); color: var(--maroon); cursor: pointer; }
</style>
