---
import { siteConfig, whatsappUrl } from '@/data/site-config';
import Icon from './Icon.astro';
const { productName, sku } = Astro.props as { productName?: string; sku?: string };
const message = productName
  ? `Hello Navira Jewels, I would like to enquire about ${productName} (${sku}). Please share more details.`
  : 'Hello Navira Jewels, I would like to know more about your Navratna bangle catalogue.';
---
<section class="contact-band" aria-labelledby="contact-band-title">
  <div>
    <p class="eyebrow">Personal assistance</p>
    <h2 id="contact-band-title">Have a piece in mind?</h2>
    <p>Speak with us directly for product information, sizing guidance, and availability. This is an enquiry only.</p>
  </div>
  <div class="contact-actions">
    <a class="button button--whatsapp" href={whatsappUrl(message)} target="_blank" rel="noopener"><Icon name="whatsapp" /> Enquire on WhatsApp</a>
    <a class="button button--outline" href={`tel:${siteConfig.phoneHref}`}><Icon name="phone" /> Call {siteConfig.phoneDisplay}</a>
  </div>
</section>
<style>
  .contact-band { display: grid; align-items: center; gap: 36px; padding: clamp(34px, 6vw, 64px); border: 1px solid var(--gold-soft); border-radius: var(--radius-lg); background: linear-gradient(135deg, #fffaf0, #f2e6d5); grid-template-columns: 1.2fr .8fr; }
  .contact-band h2 { font-size: clamp(2.5rem, 5vw, 4.5rem); }
  .contact-band p:last-child { max-width: 58ch; margin: 18px 0 0; color: var(--muted); }
  .contact-actions { display: flex; align-items: stretch; flex-direction: column; gap: 12px; }
  @media (max-width: 760px) { .contact-band { grid-template-columns: 1fr; } }
</style>
