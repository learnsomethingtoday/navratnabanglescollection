---
import { siteUrl } from '@/lib/site-url';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro';
import ProductGallery from '@/components/catalogue/ProductGallery.astro';
import ProductGrid from '@/components/catalogue/ProductGrid.astro';
import ProductPrice from '@/components/catalogue/ProductPrice.astro';
import ContactBand from '@/components/shared/ContactBand.astro';
import { formatAvailability, getProducts, getRelatedProducts, type ProductEntry } from '@/lib/products';
import { siteConfig } from '@/data/site-config';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.data.slug }, props: { product, products } }));
}
const { product, products } = Astro.props as { product: ProductEntry; products: ProductEntry[] };
const related = getRelatedProducts(product, products, 3);
const { data } = product;
---
<BaseLayout title={data.name} description={data.summary} image={data.images[0].src}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Collection', href: '/catalogue/' }, { label: data.name }]} />
  <section class="product-detail container">
    <ProductGallery images={data.images} productName={data.name} />
    <div class="product-info">
      <p class="eyebrow">{data.collection ?? data.categories[0]}</p>
      <h1>{data.name}</h1>
      <p class="summary">{data.summary}</p>
      <div class="status-row"><span class={`status status--${data.availability}`}>{formatAvailability(data.availability)}</span><span>SKU {data.sku}</span></div>
      <ProductPrice price={data.price} mrp={data.mrp} currency={data.currency} showPrice={data.showPrice} piecesPerSet={data.piecesPerSet} />
      <div class="top-size-selector">
        <p>Size</p>
        <div class="size-options size-options--top" role="group" aria-label={`Available sizes for ${data.name}`}>{data.sizes.map((item) => <button type="button" aria-pressed="false" data-size-option>{item}</button>)}</div>
      </div>
      <ContactBand productName={data.name} sku={data.sku} />
    </div>
  </section>
  <section class="details-section">
    <div class="container details-grid">
      <section class="product-highlights">
        <p class="eyebrow">Made for everyday ease</p>
        <h2>Product highlights</h2>
        <ul>{siteConfig.productHighlights.map((item) => <li>{item}</li>)}</ul>
      </section>
      <div class="specifications">
        <details open class="product-facts">
          <summary>Product details</summary>
          <dl>
            <div><dt>Material</dt><dd>{data.material.join(', ')}</dd></div>
            <div><dt>Colour</dt><dd class="fact-colours">{data.colors.map((color) => <span>{color.hex && <i style={`--swatch:${color.hex}`} aria-hidden="true"></i>}{color.name}</span>)}</dd></div>
          </dl>
        </details>
        <details open><summary>Features</summary><ul>{data.features.map((item) => <li>{item}</li>)}</ul></details>
        <details open><summary>Care instructions</summary><ul>{data.careInstructions.map((item) => <li>{item}</li>)}</ul></details>
      </div>
    </div>
  </section>
  <section class="section related" aria-labelledby="related-title"><div class="container"><div class="section-heading section-heading--split"><div><p class="eyebrow">Continue exploring</p><h2 id="related-title">Related designs</h2></div><a class="text-link" href={siteUrl('/catalogue/')}>View the full collection</a></div><ProductGrid products={related} /></div></section>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLElement>('.size-options').forEach((group) => {
    group.querySelectorAll<HTMLButtonElement>('[data-size-option]').forEach((option) => {
      option.addEventListener('click', () => {
        group.querySelectorAll<HTMLButtonElement>('[data-size-option]').forEach((item) => {
          item.setAttribute('aria-pressed', String(item === option));
        });
      });
    });
  });
</script>
<style>
  .product-detail { display: grid; align-items: start; gap: clamp(42px, 7vw, 92px); padding: clamp(42px, 7vw, 84px) 0 clamp(70px, 9vw, 110px); grid-template-columns: 1fr .9fr; }
  .product-info { position: sticky; top: 118px; min-width: 0; }
  .product-info h1 { font-size: clamp(3.1rem, 6vw, 5.8rem); }
  .summary { margin: 26px 0; color: var(--muted); font-size: 1.05rem; }
  .status-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 28px; padding: 15px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); color: var(--muted); font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; }
  .status { display: inline-flex; align-items: center; gap: 8px; color: var(--emerald); font-weight: 600; }
  .status::before { width: 8px; height: 8px; border-radius: 50%; content: ''; background: currentColor; }
  .status--unavailable { color: #8b3838; }
  .product-info :global(.contact-band) { grid-template-columns: 1fr; padding: 26px; border-radius: var(--radius-md); }
  .product-info :global(.contact-band h2) { font-size: 2rem; }
  .product-info :global(.contact-band p:last-child) { font-size: .82rem; }
  .details-section { padding: clamp(70px, 9vw, 110px) 0; background: var(--maroon-dark); color: #eee1dc; }
  .details-grid { display: grid; align-items: start; gap: clamp(50px, 9vw, 120px); grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); }
  .specifications { min-width: 0; }
  .specifications details { border-top: 1px solid rgb(255 255 255 / 18%); }
  .specifications details:last-child { border-bottom: 1px solid rgb(255 255 255 / 18%); }
  .specifications summary { padding: 22px 0; color: white; font-family: var(--serif); font-size: 1.65rem; cursor: pointer; }
  .specifications ul { display: grid; gap: 8px; margin: -6px 0 22px; padding-left: 20px; color: #cfbfb8; }
  .product-highlights { position: sticky; top: 118px; margin: 0; padding: clamp(22px, 4vw, 32px); border: 1px solid rgb(225 194 126 / 35%); border-radius: var(--radius-md); background: rgb(255 255 255 / 5%); }
  .product-highlights .eyebrow { color: var(--gold-soft); }
  .product-highlights h2 { margin: 7px 0 20px; color: white; font-size: clamp(2rem, 4vw, 2.8rem); }
  .product-highlights ul { display: grid; gap: 12px 18px; margin: 0; padding: 0; color: #eee1dc; grid-template-columns: repeat(2, minmax(0, 1fr)); list-style: none; }
  .product-highlights li { position: relative; padding-left: 24px; }
  .product-highlights li::before { position: absolute; top: .55em; left: 0; width: 8px; height: 8px; border-radius: 50%; content: ''; background: var(--gold-soft); box-shadow: 0 0 0 4px rgb(225 194 126 / 12%); }
  .product-facts dl { display: grid; gap: 0; margin: -2px 0 4px; }
  .product-facts dl > div { display: grid; gap: 18px; padding: 14px 0; border-top: 1px solid rgb(255 255 255 / 10%); grid-template-columns: minmax(90px, .35fr) 1fr; }
  .product-facts dl > div:first-child { border-top: 0; }
  .product-facts dt { color: var(--gold-soft); font-size: .74rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
  .product-facts dd { margin: 0; color: #eee1dc; }
  .fact-colours, .fact-colours span { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .fact-colours i { width: 16px; height: 16px; border: 1px solid white; border-radius: 50%; background: var(--swatch); }
  .related { background: var(--paper); }
  .related .section-heading > a { justify-self: end; align-self: end; }
  @media (max-width: 880px) { .product-detail, .details-grid { grid-template-columns: 1fr; } .product-info, .product-highlights { position: static; } }
  @media (max-width: 720px) { .related .section-heading > a { justify-self: start; } .product-highlights ul { grid-template-columns: 1fr; } .product-facts dl > div { gap: 6px; grid-template-columns: 1fr; } }
</style>
