---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro';
import ProductGallery from '@/components/catalogue/ProductGallery.astro';
import ProductGrid from '@/components/catalogue/ProductGrid.astro';
import ContactBand from '@/components/shared/ContactBand.astro';
import { formatAvailability, getProducts, getRelatedProducts, type ProductEntry } from '@/lib/products';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.data.slug }, props: { product, products } }));
}
const { product, products } = Astro.props as { product: ProductEntry; products: ProductEntry[] };
const { Content } = await render(product);
const related = getRelatedProducts(product, products, 3);
const { data } = product;
const displayPrice = data.showPrice && data.price != null && data.currency
  ? new Intl.NumberFormat('en-IN', { style: 'currency', currency: data.currency }).format(data.price)
  : null;
---
<BaseLayout title={data.name} description={data.summary} image={data.images[0].src}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Catalogue', href: '/catalogue/' }, { label: data.name }]} />
  <section class="product-detail container">
    <ProductGallery images={data.images} productName={data.name} />
    <div class="product-info">
      <span class="placeholder-label">Preview product</span>
      <p class="eyebrow">{data.collection ?? data.categories[0]}</p>
      <h1>{data.name}</h1>
      <p class="summary">{data.summary}</p>
      <div class="status-row"><span class={`status status--${data.availability}`}>{formatAvailability(data.availability)}</span><span>SKU {data.sku}</span></div>
      {displayPrice && <p class="price">{displayPrice}</p>}
      <ContactBand productName={data.name} sku={data.sku} />
    </div>
  </section>
  <section class="details-section">
    <div class="container details-grid">
      <article class="description"><p class="eyebrow">The piece</p><h2>Product story</h2><div class="prose"><Content /></div></article>
      <div class="specifications">
        <details open><summary>Materials</summary><ul>{data.material.map((item) => <li>{item}</li>)}</ul></details>
        <details open><summary>Available sizes</summary><ul>{data.sizes.map((item) => <li>{item}</li>)}</ul></details>
        <details open><summary>Available colors</summary><ul class="color-list">{data.colors.map((color) => <li>{color.hex && <span style={`--swatch:${color.hex}`}></span>}{color.name}</li>)}</ul></details>
        <details open><summary>Features</summary><ul>{data.features.map((item) => <li>{item}</li>)}</ul></details>
        <details open><summary>Care instructions</summary><ul>{data.careInstructions.map((item) => <li>{item}</li>)}</ul></details>
      </div>
    </div>
  </section>
  <section class="section related" aria-labelledby="related-title"><div class="container"><div class="section-heading section-heading--split"><div><p class="eyebrow">Continue exploring</p><h2 id="related-title">Related previews</h2></div><a class="text-link" href="/catalogue/">View the full catalogue</a></div><ProductGrid products={related} /></div></section>
</BaseLayout>
<style>
  .product-detail { display: grid; align-items: start; gap: clamp(42px, 7vw, 92px); padding: clamp(42px, 7vw, 84px) 0 clamp(70px, 9vw, 110px); grid-template-columns: 1fr .9fr; }
  .product-info { position: sticky; top: 118px; min-width: 0; }
  .product-info > .placeholder-label { margin-bottom: 24px; }
  .product-info h1 { font-size: clamp(3.1rem, 6vw, 5.8rem); }
  .summary { margin: 26px 0; color: var(--muted); font-size: 1.05rem; }
  .status-row { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 28px; padding: 15px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); color: var(--muted); font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; }
  .status { display: inline-flex; align-items: center; gap: 8px; color: var(--emerald); font-weight: 600; }
  .status::before { width: 8px; height: 8px; border-radius: 50%; content: ''; background: currentColor; }
  .status--unavailable { color: #8b3838; }
  .price { color: var(--maroon); font-family: var(--serif); font-size: 2rem; }
  .product-info :global(.contact-band) { grid-template-columns: 1fr; padding: 26px; border-radius: var(--radius-md); }
  .product-info :global(.contact-band h2) { font-size: 2rem; }
  .product-info :global(.contact-band p:last-child) { font-size: .82rem; }
  .details-section { padding: clamp(70px, 9vw, 110px) 0; background: var(--maroon-dark); color: #eee1dc; }
  .details-grid { display: grid; gap: clamp(50px, 9vw, 120px); grid-template-columns: .8fr 1.2fr; }
  .description { position: sticky; top: 118px; align-self: start; }
  .description h2 { color: white; }
  .description .eyebrow { color: var(--gold-soft); }
  .prose { margin-top: 24px; color: #cfbfb8; }
  .specifications details { border-top: 1px solid rgb(255 255 255 / 18%); }
  .specifications details:last-child { border-bottom: 1px solid rgb(255 255 255 / 18%); }
  .specifications summary { padding: 22px 0; color: white; font-family: var(--serif); font-size: 1.65rem; cursor: pointer; }
  .specifications ul { display: grid; gap: 8px; margin: -6px 0 22px; padding-left: 20px; color: #cfbfb8; }
  .color-list li { display: flex; align-items: center; gap: 10px; }
  .color-list span { width: 16px; height: 16px; border: 1px solid white; border-radius: 50%; background: var(--swatch); }
  .related { background: var(--paper); }
  .related .section-heading > a { justify-self: end; align-self: end; }
  @media (max-width: 880px) { .product-detail, .details-grid { grid-template-columns: 1fr; } .product-info, .description { position: static; } }
  @media (max-width: 720px) { .related .section-heading > a { justify-self: start; } }
</style>
