---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro';
import ProductGrid from '@/components/catalogue/ProductGrid.astro';
import ContactBand from '@/components/shared/ContactBand.astro';
import Icon from '@/components/shared/Icon.astro';
import { getProducts } from '@/lib/products';
const products = await getProducts();
const categories = [...new Set(products.flatMap(({ data }) => data.categories))].sort();
const collections = [...new Set(products.map(({ data }) => data.collection).filter((value): value is string => Boolean(value)))].sort();
---
<BaseLayout title="Catalogue" description="Browse the Navira Jewels preview catalogue of Navratna bangles.">
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Catalogue' }]} />
  <header class="page-header container">
    <div><p class="eyebrow">The collection</p><h1>Find your<br /><em>kind of colour.</em></h1></div>
    <div><p class="lede">Explore our growing Navratna bangle catalogue. Every current entry is preview content awaiting final photography and verified specifications.</p><span class="placeholder-label">9 preview products</span></div>
  </header>

  <section class="catalogue-section" aria-labelledby="catalogue-title">
    <div class="container">
      <h2 id="catalogue-title" class="sr-only">All catalogue products</h2>
      <div class="catalogue-controls">
        <label class="search-field"><span>Search catalogue</span><span class="input-wrap"><Icon name="search" size={18} /><input type="search" name="search" placeholder="Name, SKU, material or tag" autocomplete="off" data-product-search /></span></label>
        <label><span>Category</span><select data-category-filter><option value="">All categories</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label>
        <label><span>Collection</span><select data-collection-filter><option value="">All collections</option>{collections.map((collection) => <option value={collection}>{collection}</option>)}</select></label>
        <button class="reset-button" type="button" data-reset-filters>Clear filters</button>
      </div>
      <div class="results-bar"><p aria-live="polite" aria-atomic="true" data-result-count>Showing all {products.length} products</p><p>Catalogue preview · No online ordering</p></div>
      <ProductGrid products={products} id="product-grid" />
      <div class="empty-state" data-empty-state hidden><h3>No pieces found</h3><p>Try a different search term or clear the filters to see the full preview catalogue.</p><button class="button button--outline" type="button" data-empty-reset>Clear all filters</button></div>
    </div>
  </section>
  <div class="container section--compact"><ContactBand /></div>
</BaseLayout>
<script>
  const search = document.querySelector<HTMLInputElement>('[data-product-search]');
  const category = document.querySelector<HTMLSelectElement>('[data-category-filter]');
  const collection = document.querySelector<HTMLSelectElement>('[data-collection-filter]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-product-card]')];
  const count = document.querySelector<HTMLElement>('[data-result-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty-state]');
  const applyFilters = () => {
    const query = search?.value.trim().toLowerCase() ?? '';
    const selectedCategory = category?.value ?? '';
    const selectedCollection = collection?.value ?? '';
    let visible = 0;
    cards.forEach((card) => {
      const matchesQuery = !query || card.dataset.search?.includes(query);
      const matchesCategory = !selectedCategory || card.dataset.categories?.split('|').includes(selectedCategory);
      const matchesCollection = !selectedCollection || card.dataset.collection === selectedCollection;
      const show = Boolean(matchesQuery && matchesCategory && matchesCollection);
      card.hidden = !show;
      if (show) visible += 1;
    });
    if (count) count.textContent = visible === cards.length ? `Showing all ${visible} products` : `Showing ${visible} of ${cards.length} products`;
    if (empty) empty.hidden = visible !== 0;
  };
  const reset = () => { if (search) search.value = ''; if (category) category.value = ''; if (collection) collection.value = ''; applyFilters(); search?.focus(); };
  search?.addEventListener('input', applyFilters);
  category?.addEventListener('change', applyFilters);
  collection?.addEventListener('change', applyFilters);
  document.querySelectorAll('[data-reset-filters], [data-empty-reset]').forEach((button) => button.addEventListener('click', reset));
</script>
<style>
  .page-header { display: grid; align-items: end; gap: clamp(40px, 8vw, 110px); padding: clamp(52px, 8vw, 104px) 0 clamp(56px, 7vw, 88px); grid-template-columns: 1.1fr .9fr; }
  .page-header h1 { font-size: clamp(3.5rem, 8vw, 7rem); }
  .page-header h1 em { color: var(--gold); font-weight: 500; }
  .page-header .lede { margin-bottom: 20px; }
  .catalogue-section { padding: clamp(38px, 6vw, 72px) 0 clamp(70px, 10vw, 120px); background: var(--paper); }
  .catalogue-controls { display: grid; align-items: end; gap: 14px; padding: 18px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--ivory); grid-template-columns: 1.5fr .85fr .85fr auto; }
  .catalogue-controls label { display: grid; gap: 7px; color: var(--muted); font-size: .68rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; }
  .input-wrap { position: relative; display: block; }
  .input-wrap svg { position: absolute; top: 50%; left: 14px; color: var(--muted); transform: translateY(-50%); }
  input, select { width: 100%; min-height: 48px; padding: 10px 14px; border: 1px solid var(--line); border-radius: 9px; background: var(--white); color: var(--ink); font-size: .85rem; }
  input { padding-left: 43px; }
  .reset-button { min-height: 48px; padding: 10px 16px; border: 0; background: transparent; color: var(--maroon); font-size: .75rem; font-weight: 600; cursor: pointer; }
  .results-bar { display: flex; justify-content: space-between; margin: 26px 0; color: var(--muted); font-size: .72rem; }
  .results-bar p { margin: 0; }
  .empty-state { padding: 72px 20px; text-align: center; }
  .empty-state h3 { margin-bottom: 12px; }
  .empty-state p { color: var(--muted); }
  @media (max-width: 900px) { .catalogue-controls { grid-template-columns: 1fr 1fr; } .search-field { grid-column: 1 / -1; } }
  @media (max-width: 700px) { .page-header { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .catalogue-controls { grid-template-columns: 1fr; } .search-field { grid-column: auto; } .results-bar { align-items: flex-start; flex-direction: column; gap: 4px; } }
</style>
