---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/shared/Breadcrumbs.astro';
import Icon from '@/components/shared/Icon.astro';
import { siteConfig, whatsappUrl } from '@/data/site-config';
const generalMessage = 'Hello Navira Jewels, I would like to know more about your Navratna bangle catalogue.';
---
<BaseLayout title="Contact" description="Call or WhatsApp Navira Jewels for catalogue and product information.">
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} />
  <header class="contact-hero container">
    <div><span class="placeholder-label">Direct catalogue enquiries</span><p class="eyebrow">Let’s talk</p><h1>Questions?<br /><em>We’re listening.</em></h1></div>
    <p class="lede">Ask about a design, availability, sizing, or future catalogue additions. Your message starts a conversation—it does not place an order.</p>
  </header>

  <section class="contact-main">
    <div class="container contact-grid">
      <div class="contact-actions">
        <article>
          <span class="contact-icon"><Icon name="whatsapp" size={24} /></span>
          <div><p class="eyebrow">WhatsApp</p><h2>Start a conversation</h2><p>Open WhatsApp with a ready-to-send catalogue enquiry.</p><a class="button button--whatsapp" href={whatsappUrl(generalMessage)} target="_blank" rel="noopener">Message us <Icon name="arrow" /></a></div>
        </article>
        <article>
          <span class="contact-icon"><Icon name="phone" size={24} /></span>
          <div><p class="eyebrow">Phone</p><h2>{siteConfig.phoneDisplay}</h2><p>Call directly for product information, assistance and orders.</p><a class="button button--outline" href={`tel:${siteConfig.phoneHref}`}>Call now <Icon name="arrow" /></a></div>
        </article>
      </div>
      <aside class="details-card" aria-labelledby="business-info-title">
        <span class="placeholder-label">Service information</span>
        <h2 id="business-info-title">Business information</h2>
        <div><Icon name="pin" /><p><strong>Local delivery</strong><span>{siteConfig.localDelivery}</span></p></div>
        <div><Icon name="clock" /><p><strong>Regional dispatch</strong><span>{siteConfig.regionalDispatch}</span></p></div>
        <div><Icon name="clock" /><p><strong>Response time</strong><span>{siteConfig.responseTime}</span></p></div>
        <div><Icon name="clock" /><p><strong>Business hours</strong><span>{siteConfig.hours}</span></p></div>
      </aside>
    </div>
  </section>

</BaseLayout>
<style>
  .contact-hero { display: grid; align-items: end; gap: clamp(40px, 8vw, 110px); padding: clamp(52px, 8vw, 104px) 0 clamp(70px, 9vw, 110px); grid-template-columns: 1.1fr .9fr; }
  .contact-hero .placeholder-label { margin-bottom: 34px; }
  .contact-hero h1 { font-size: clamp(3.5rem, 8vw, 7rem); }
  .contact-hero h1 em { color: var(--gold); font-weight: 500; }
  .contact-main { padding: clamp(54px, 8vw, 92px) 0; background: var(--paper); }
  .contact-grid { display: grid; gap: clamp(28px, 5vw, 64px); grid-template-columns: 1.25fr .75fr; }
  .contact-actions { display: grid; gap: 18px; }
  .contact-actions article { display: grid; gap: 24px; padding: clamp(28px, 5vw, 48px); border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--ivory); grid-template-columns: auto 1fr; }
  .contact-icon { display: grid; width: 52px; height: 52px; place-items: center; border: 1px solid var(--gold-soft); border-radius: 50%; color: var(--maroon); }
  .contact-actions h2 { font-size: clamp(2rem, 4vw, 3rem); }
  .contact-actions article p:not(.eyebrow) { color: var(--muted); }
  .details-card { align-self: start; padding: clamp(30px, 5vw, 48px); border-radius: var(--radius-md); background: var(--maroon-dark); color: white; }
  .details-card h2 { margin: 24px 0 32px; color: white; }
  .details-card > div { display: grid; gap: 16px; padding: 22px 0; border-top: 1px solid rgb(255 255 255 / 15%); grid-template-columns: 24px 1fr; }
  .details-card p { display: grid; margin: 0; }
  .details-card strong { color: var(--gold-soft); font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; }
  .details-card > div span { color: #d4c7c1; font-size: .85rem; }
  @media (max-width: 820px) { .contact-hero, .contact-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .contact-actions article { grid-template-columns: 1fr; } }
</style>
