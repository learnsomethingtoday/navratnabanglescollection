---
import { siteUrl } from '@/lib/site-url';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductGrid from '@/components/catalogue/ProductGrid.astro';
import ContactBand from '@/components/shared/ContactBand.astro';
import TrustMetrics from '@/components/shared/TrustMetrics.astro';
import Icon from '@/components/shared/Icon.astro';
import { getFeaturedProducts } from '@/lib/products';
const featured = await getFeaturedProducts(3);
---
<BaseLayout>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Nine hues · countless moments</p>
        <h1>Grace, set<br />in <em>colour.</em></h1>
        <p class="hero-lede">Discover an evolving catalogue of Navratna-inspired bangles, presented for everyday poise, meaningful celebrations, and everything between.</p>
        <div class="hero-actions">
          <a class="button" href={siteUrl('/catalogue/')}>Explore the catalogue <Icon name="arrow" /></a>
          <a class="text-link hero-story-link" href={siteUrl('/about/')}>Discover our story</a>
        </div>
        <p class="catalogue-note">Catalogue only · Order/Enquire by call or WhatsApp</p>
      </div>
      <div class="hero-art">
        <div class="hero-card">
          <img src={siteUrl('/images/products/navratna-poise-preview-01/01-wood-display.webp')} alt="A pair of multicolour gold-tone bangles displayed against a carved wooden box" width="1256" height="1256" loading="eager" fetchpriority="high" decoding="async" />
        </div>
      </div>
    </div>
    <div class="hero-marquee" aria-hidden="true"><span>Panchaloha Bangles</span><span>Timeless Colour</span><span>Everyday Grace</span></div>
  </section>

  <section class="section featured" aria-labelledby="featured-title">
    <div class="container">
      <div class="section-heading section-heading--split">
        <div><p class="eyebrow">A first glimpse</p><h2 id="featured-title">The featured edit</h2></div>
        <div><p class="lede">Explore a thoughtfully selected edit of available designs, with more additions joining the catalogue soon.</p><a class="text-link" href={siteUrl('/catalogue/')}>View the full catalogue</a></div>
      </div>
      <ProductGrid products={featured} />
      <div class="featured-catalogue-cta">
        <a class="button button--outline" href={siteUrl('/catalogue/')}>View full catalogue <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section values" aria-labelledby="values-title">
    <div class="container values-grid">
      <div class="values-intro"><p class="eyebrow">Why Navratna bangles</p><h2 id="values-title">Captivating style, with everyday ease.</h2><p class="lede">A colourful, elegant alternative for those who love the richness of gold jewellery but want a more approachable option for regular wear.</p></div>
      <div class="value-list">
        <article><span>01</span><div><h3>Gold-inspired elegance</h3><p>Designed with a rich gold-tone finish that brings the elegant look of traditional gold bangles at a more accessible price.</p></div></article>
        <article><span>02</span><div><h3>More approachable value</h3><p>When crafted from confirmed non-gold or gold-finished materials, a bangle can be more affordable than a solid-gold design while retaining an elegant visual presence.</p></div></article>
        <article><span>03</span><div><h3>Less worry for regular wear</h3><p>A lower-value alternative can mean less financial exposure than high-value gold jewellery if it is misplaced—though every piece should still be worn and stored with care.</p></div></article>
      </div>
    </div>
  </section>

  <section class="section story">
    <div class="container story-grid">
      <div class="story-visual" aria-hidden="true"><span>N</span><div class="story-ring"></div><p>Nine tones.<br />One graceful whole.</p></div>
      <div class="story-copy"><p class="eyebrow">Our point of view</p><h2>A tradition of colour, styled for now.</h2><p class="lede">Navratna jewellery is known for bringing nine distinct colours into one balanced composition. Navira Jewels presents that variety with warmth, simplicity, and breathing room.</p><a class="button button--outline" href={siteUrl('/about/')}>Read our story <Icon name="arrow" /></a></div>
    </div>
  </section>

  <div class="container section--compact"><ContactBand /></div>

  <TrustMetrics />
</BaseLayout>
<style>
  .hero { position: relative; overflow: hidden; padding: clamp(56px, 8vw, 112px) 0 0; background: radial-gradient(circle at 78% 30%, #eadcc5 0, transparent 33%), var(--ivory); }
  .hero::before { position: absolute; top: 0; bottom: 0; left: 7vw; width: 1px; content: ''; background: linear-gradient(transparent, var(--gold-soft), transparent); }
  .hero-grid { display: grid; align-items: center; gap: clamp(40px, 7vw, 100px); grid-template-columns: 1.08fr .92fr; }
  .hero-copy { position: relative; z-index: 2; padding-bottom: 80px; }
  .hero-copy h1 em { color: var(--gold); font-weight: 500; }
  .hero-lede { max-width: 58ch; margin: 30px 0; color: var(--muted); font-size: clamp(1rem, 1.6vw, 1.15rem); }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 24px; }
  .catalogue-note { display: none; margin: 20px 0 0; color: #8b7d77; font-size: .7rem; letter-spacing: .04em; }
  .hero-art { position: relative; min-height: 620px; }
  .hero-card { position: absolute; inset: 4% 3% 5% 10%; overflow: hidden; border: 1px solid rgb(181 138 58 / 35%); border-radius: var(--radius-lg); background: #f1e7d9; box-shadow: var(--shadow-md); }
  .hero-card img { width: 100%; height: 100%; object-fit: cover; object-position: center; animation: hero-image-drift 10s ease-in-out infinite alternate; will-change: transform; }
  .hero-marquee { display: flex; min-width: max-content; align-items: center; justify-content: center; padding: 16px; border-top: 1px solid var(--gold-soft); border-bottom: 1px solid var(--gold-soft); background: #f7efdf; color: var(--maroon); font-family: var(--serif); font-size: 1.15rem; font-style: italic; }
  .hero-marquee span + span::before { margin: 0 30px; color: var(--gold); content: '✦'; font-size: .7rem; }
  @keyframes hero-image-drift { from { transform: scale(1.02); } to { transform: scale(1.10); } }
  .featured { background: var(--paper); }
  .section-heading .text-link { display: inline-block; margin-top: 12px; }
  .featured-catalogue-cta { display: flex; justify-content: center; margin-top: 40px; }
  @media (min-width: 901px) { .featured { padding-bottom: 72px; } }
  .values { background: var(--maroon-dark); color: #f9eee8; }
  .values-grid { display: grid; gap: clamp(50px, 9vw, 120px); grid-template-columns: .85fr 1.15fr; }
  .values h2, .values h3 { color: white; }
  .values .eyebrow { color: var(--gold-soft); }
  .values .lede, .value-list p { color: #cfbfb8; }
  .value-list article { display: grid; gap: 24px; padding: 32px 0; border-top: 1px solid rgb(255 255 255 / 16%); grid-template-columns: 42px 1fr; }
  .value-list article:last-child { border-bottom: 1px solid rgb(255 255 255 / 16%); }
  .value-list article > span { color: var(--gold-soft); font-family: var(--serif); font-size: 1.2rem; }
  .value-list h3 { font-size: 2rem; }
  .value-list p { margin: 8px 0 0; }
  .story { background: var(--ivory); }
  .story-grid { display: grid; align-items: center; gap: clamp(50px, 9vw, 130px); grid-template-columns: .9fr 1.1fr; }
  .story-visual { position: relative; display: grid; min-height: 500px; place-items: center; overflow: hidden; border-radius: 260px 260px 28px 28px; background: var(--emerald); color: white; }
  .story-visual > span { color: rgb(255 255 255 / 8%); font-family: var(--serif); font-size: 22rem; line-height: 1; }
  .story-visual p { position: absolute; bottom: 34px; left: 50%; width: max-content; max-width: calc(100% - 40px); color: var(--gold-soft); font-family: var(--serif); font-size: 1.75rem; line-height: 1.05; text-align: center; transform: translateX(-50%); }
  .story-ring { position: absolute; width: 230px; height: 230px; border: 2px solid var(--gold-soft); border-radius: 50%; box-shadow: 0 0 0 24px rgb(230 210 170 / 7%), 0 0 0 48px rgb(230 210 170 / 5%); }
  .story-copy .lede { margin: 28px 0 34px; }
  @media (max-width: 900px) { .hero-grid, .values-grid, .story-grid { grid-template-columns: 1fr; } .hero-art { min-height: 520px; } .hero-card { inset: 0 8% 4%; } .values-intro { max-width: 620px; } }
  @media (max-width: 640px) { .hero-art { display: none; } .hero::before { display: none; } }
  @media (max-width: 640px) { .hero-story-link { display: none; } }
  @media (max-width: 640px) { .catalogue-note { display: block; } }
  @media (max-width: 540px) {
    .hero { padding-top: 36px; }
    .hero-copy { padding-bottom: 48px; }
    .hero-marquee { min-width: 0; display: grid; gap: 6px 12px; padding: 10px 8px 12px; font-size: clamp(.82rem, 4vw, .95rem); line-height: 1.15; text-align: center; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero-marquee span:first-child { grid-column: 1 / -1; }
    .hero-marquee span + span::before { display: none; }
    .story-visual { min-height: 390px; }
    .story-ring { width: 190px; height: 190px; }
    .story-visual p { bottom: 24px; font-size: 1.5rem; }
    .featured-catalogue-cta .button { width: 100%; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) { .hero-card img { animation: none; transform: none; will-change: auto; } }
</style>
